---
import SunIcon from "@phosphor-icons/core/assets/bold/sun-bold.svg";
import TranslateIcon from "@phosphor-icons/core/assets/bold/translate-bold.svg";
import type { HTMLAttributes } from "astro/types";

import Button from "&ui/Button/Button.astro";
import Icon from "&ui/Icon.astro";
import Navigation from "&ui/Navigation.astro";

import { MetaLoader } from "&utils/compositional/i18n/metaLoader.ts";

interface Props extends HTMLAttributes<"header"> {}

const { ...attributes } = Astro.props;

const classList = ["header"];

const meta = await MetaLoader.getAsync(Astro.currentLocale);
const title = meta.home.title;
---

<header class:list={[classList, attributes.class]} {...attributes}>
  <a class="title" href="/">{title}</a>
  <nav aria-label="Primary Navigation">
    <Navigation mode="default" />
  </nav>
  <Button class="icon translate-icon" color="var(--accent-secondary)" size="xl" variant="icon">
    <Icon><TranslateIcon /></Icon>
  </Button>
  <Button class="icon sun-icon" color="var(--accent-secondary)" size="xl" variant="icon">
    <Icon><SunIcon /></Icon>
  </Button>
</header>

<style>
  .header {
    display: grid;
    grid-template:
      "title title" auto
      "locale theme" auto
      "navigation navigation" auto
      / 1fr 1fr;
    gap: var(--space-3);
    padding: var(--space-2);
    background: var(--bg-secondary);
    border-bottom: 3px solid var(--accent-primary);
    box-shadow: var(--shadow-1);
  }

  .title {
    grid-area: title;
    margin: 0;
    font-family: var(--font-family-title);
    font-size: var(--font-size-6);
    font-weight: var(--w-semibold);
    line-height: var(--lh-title);
    color: var(--accent-primary);
    text-align: center;
    text-transform: uppercase;
    text-decoration: none;
  }

  nav {
    grid-area: navigation;
  }

  .translate-icon {
    grid-area: locale;
    justify-self: start;
  }

  .sun-icon {
    grid-area: theme;
    justify-self: end;
  }

  @media (width > 950px) {
    .header {
      grid-template:
        "title fill navigation locale theme" auto
        / max-content 1fr max-content max-content max-content;
      padding: var(--space-1) var(--space-2);
    }

    nav {
      align-self: center;
    }
  }
</style>
